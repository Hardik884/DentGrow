# =============================================================================
# DentGrow — Environment Variables Reference
# Copy this file to .env.local and fill in actual values.
# NEVER commit .env.local to version control.
# =============================================================================

# Supabase — safe for browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server-side only (NO NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI — server-side only
GOOGLE_AI_API_KEY=your-gemini-api-key

# n8n — server-side only
N8N_WEBHOOK_SECRET=your-shared-secret
N8N_BASE_URL=https://your-n8n-instance.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
